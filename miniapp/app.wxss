/* ═══════════════════════════════════════
   风林慧策 — 全局样式
   ═══════════════════════════════════════ */

page {
  --navy: #1E40AF;
  --teal: #0D9488;
  --amber: #B45309;
  --purple: #7C3AED;
  --gold: #CA8A04;
  --red: #DC2626;
  --green: #16A34A;
  --surface: #F8F9FA;
  --text: #1A1A2E;
  --text2: #6B7280;
  --text3: #9CA3AF;
  --border: #E5E7EB;
  --white: #FFFFFF;

  background: var(--white);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
}

.container { padding: 0 32rpx; }

/* ── Header ── */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand { font-size: 36rpx; font-weight: 700; color: var(--navy); }
.brand-sub { font-size: 22rpx; color: var(--text3); margin-top: 4rpx; }
.header-right { margin-left: auto; display: flex; gap: 16rpx; align-items: center; }

.btn-sm {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  border: 1rpx solid var(--border);
  background: #fff;
  color: var(--text);
}

.btn-primary {
  background: var(--navy);
  color: #fff;
  border: none;
}

/* ── Cards ── */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid var(--border);
  padding: 32rpx;
  margin: 24rpx 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

/* ── PMQD Badge Colors ── */
.pmqd-star5 { color: var(--gold); }
.pmqd-star4 { color: var(--green); }
.pmqd-star3 { color: var(--teal); }
.pmqd-star2 { color: var(--amber); }
.pmqd-star1 { color: var(--red); }

/* ── Utility ── */
.text-center { text-align: center; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }

/* ── Modal Overlay ── */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  width: 600rpx;
  max-width: 90vw;
}

/* ── Ring Progress ── */
.ring-wrapper {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  margin: 0 auto;
  text-align: center;
}

.ring-label {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text);
}

.ring-desc {
  font-size: 22rpx;
  color: var(--text2);
}
