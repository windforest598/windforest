/* ═══════════════════════════════════════
   搜索首页样式
   ═══════════════════════════════════════ */

.page-index {
  min-height: 100vh;
  background: #FFFFFF;
}

/* Hero */
.hero {
  padding: 60rpx 32rpx 40rpx;
  text-align: center;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 40rpx;
}

/* Section */
.section {
  padding: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

/* Chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text);
  white-space: nowrap;
}

/* Tabs */
.tab-row {
  display: flex;
  border-bottom: 2rpx solid var(--border);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text2);
  border-bottom: 4rpx solid transparent;
  margin-bottom: -2rpx;
}

.tab.active {
  color: var(--navy);
  border-bottom-color: var(--navy);
  font-weight: 600;
}

/* Form */
.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-full {
  width: 100%;
  padding: 20rpx;
  background: var(--navy);
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.page-footer {
  text-align: center;
  padding: 40rpx;
  color: var(--text3);
  font-size: 22rpx;
}
