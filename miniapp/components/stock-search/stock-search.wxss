/* ═══════════════════════════════════════
   股票搜索组件样式
   ═══════════════════════════════════════ */

.search-wrapper {
  position: relative;
  width: 100%;
}

.search-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid var(--border);
  border-radius: 48rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  height: 48rpx;
  line-height: 48rpx;
}

.search-clear {
  font-size: 28rpx;
  color: var(--text3);
  padding: 8rpx 12rpx;
}

/* ── Suggestions ── */
.suggestions {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.10);
  z-index: 200;
  max-height: 480rpx;
  overflow: hidden;
}

.suggestions-scroll {
  max-height: 480rpx;
}

.suggestion-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item.selected {
  background: #EFF6FF;
}

.sug-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sug-name {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.sug-sector {
  font-size: 22rpx;
  color: var(--text3);
}

.sug-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.sug-code {
  font-size: 24rpx;
  color: var(--text2);
  font-family: monospace;
}

.sug-mk {
  font-size: 20rpx;
  color: var(--teal);
  background: #E6FFFA;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
